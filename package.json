{
  "name": "fsp-toolset-modern",
  "displayName": "FSP Toolset Modern",
  "description": "Zero-config VS Code IDE for FSP / LTS automata: live graph preview, interactive simulator, CodeLens, safety & progress verification with visual counterexamples.",
  "version": "0.2.1",
  "publisher": "EdoardoDesiderio",
  "author": {
    "name": "Edoardo Desiderio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edoardoD/fsp-toolset.git"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:fsp",
    "onView:fspExplorer",
    "onCommand:fspModern.compile",
    "onCommand:fspModern.showGraph",
    "onCommand:fspModern.showGraphTarget",
    "onCommand:fspModern.simulateTarget",
    "onCommand:fspModern.checkSafety",
    "onCommand:fspModern.checkSafetyTarget",
    "onCommand:fspModern.checkProgress",
    "onCommand:fspModern.checkProgressTarget"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "fsp",
        "aliases": [
          "FSP",
          "fsp"
        ],
        "extensions": [
          ".lts",
          ".fsp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fsp",
        "scopeName": "source.fsp",
        "path": "./syntaxes/fsp.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fspStudio",
          "title": "FSP Studio (Automi)",
          "icon": "media/fsp-icon.svg"
        }
      ]
    },
    "views": {
      "fspStudio": [
        {
          "id": "fspExplorer",
          "name": "Esplora Automi e Proprietà"
        }
      ]
    },
    "commands": [
      {
        "command": "fspModern.compile",
        "title": "FSP: Compila File Corrente",
        "icon": "$(check)"
      },
      {
        "command": "fspModern.showGraph",
        "title": "FSP: Visualizza Grafo Interattivo",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "fspModern.showGraphTarget",
        "title": "Visualizza Grafo",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "fspModern.simulateTarget",
        "title": "Simula Passo-Passo",
        "icon": "$(play)"
      },
      {
        "command": "fspModern.checkSafety",
        "title": "FSP: Verifica Safety & Deadlock",
        "icon": "$(shield)"
      },
      {
        "command": "fspModern.checkSafetyTarget",
        "title": "Verifica Safety & Deadlock",
        "icon": "$(shield)"
      },
      {
        "command": "fspModern.checkProgress",
        "title": "FSP: Verifica Progress & Liveness",
        "icon": "$(sync)"
      },
      {
        "command": "fspModern.checkProgressTarget",
        "title": "Verifica Progress",
        "icon": "$(sync)"
      },
      {
        "command": "fspModern.refreshExplorer",
        "title": "Aggiorna FSP Explorer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceLangId == fsp",
          "command": "fspModern.showGraph",
          "group": "navigation@1"
        },
        {
          "when": "resourceLangId == fsp",
          "command": "fspModern.simulateTarget",
          "group": "navigation@2"
        },
        {
          "when": "resourceLangId == fsp",
          "command": "fspModern.checkSafety",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "fspModern.refreshExplorer",
          "when": "view == fspExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fspModern.showGraphTarget",
          "when": "view == fspExplorer && viewItem == fspTarget",
          "group": "inline@1"
        },
        {
          "command": "fspModern.simulateTarget",
          "when": "view == fspExplorer && viewItem == fspTarget",
          "group": "inline@2"
        },
        {
          "command": "fspModern.checkSafetyTarget",
          "when": "view == fspExplorer && viewItem == fspTarget",
          "group": "inline@3"
        },
        {
          "command": "fspModern.showGraphTarget",
          "when": "view == fspExplorer && viewItem == fspTarget",
          "group": "1_actions@1"
        },
        {
          "command": "fspModern.simulateTarget",
          "when": "view == fspExplorer && viewItem == fspTarget",
          "group": "1_actions@2"
        },
        {
          "command": "fspModern.checkSafetyTarget",
          "when": "view == fspExplorer && viewItem == fspTarget",
          "group": "2_verify@1"
        },
        {
          "command": "fspModern.checkProgressTarget",
          "when": "view == fspExplorer && viewItem == fspTarget",
          "group": "2_verify@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "FSP Toolset Modern",
      "properties": {
        "fspModern.ltsaJarPath": {
          "type": "string",
          "default": "",
          "description": "Optional: Path to a local ltsa.jar. If empty, the extension uses the bundled ltsa.jar."
        },
        "fspModern.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show inline CodeLens buttons (Visualizza Grafo, Simula, Safety, Progress) above processes and compositions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run build",
    "watch": "npm run build -- --watch",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node && cp src/java/FspBridge*.class dist/",
    "lint": "eslint src --ext ts",
    "test": "tsc -p ./ && mocha out/test/**/*.test.js",
    "build:java": "javac --release 8 -nowarn -cp lib/ltsa.jar src/java/FspBridge.java"
  },
  "dependencies": {
    "find-java-home": "^1.2.2",
    "unzipper": "^0.11.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.9",
    "@types/unzipper": "^0.10.9",
    "@types/vscode": "~1.93.0",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.23.0",
    "eslint": "^9.6.0",
    "mocha": "^10.5.2",
    "playwright": "^1.49.0",
    "typescript": "^5.5.3"
  }
}
